# Copy to .env and fill in. See README.md for setup details.

# PostgreSQL connection string
DATABASE_URL="postgresql://USER@localhost:5432/travel_app"

# Auth.js session encryption secret — generate with: npx auth secret
# (or: openssl rand -base64 32)
AUTH_SECRET=""

# Google OAuth credentials — https://console.cloud.google.com/apis/credentials
# OAuth client ID → Web application → authorized redirect URI:
#   http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Vercel production only: the database's direct (non-pooled) connection string,
# used to run migrations during production builds. Not needed locally.
# See README.md → Deploying to Vercel.
# DIRECT_DATABASE_URL=""

# Activity-idea suggestions (mock preview). Off unless explicitly "1".
# No credentials needed: the preview runs on a deterministic in-process mock.
# See docs/ai-readiness.md before enabling anything else.
# AI_SUGGESTIONS_ENABLED="0"
# Optional bounds (defaults shown):
# AI_SUGGEST_TIMEOUT_MS="8000"
# AI_SUGGEST_MAX_RETRIES="1"
# Persistent daily generation quotas (RESERVED + COMPLETED count; FAILED
# releases its reservation):
# AI_SUGGEST_USER_DAILY_LIMIT="20"
# AI_SUGGEST_TRIP_DAILY_LIMIT="50"
