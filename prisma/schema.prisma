generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/* ------------------------------------------------------------------ */
/* Auth.js (NextAuth v5) models — see authjs.dev/getting-started/adapters/prisma */
/* ------------------------------------------------------------------ */

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts       Account[]
  sessions       Session[]
  memberships    TripMember[]
  invitesCreated Invite[]
  expensesPaid    Expense[]      @relation("ExpensesPaid")
  expenseSplits   ExpenseSplit[]
  settlementsFrom Settlement[]   @relation("SettlementsFrom")
  settlementsTo   Settlement[]   @relation("SettlementsTo")
  settlementsRecorded Settlement[] @relation("SettlementsRecorded")
  availability    AvailabilityDay[]
  packingItems    PackingItem[]     @relation("PackingAssignee")
  personalPacking PackingItem[]     @relation("PersonalPackingItems")
  ideasCreated    ActivityIdea[]    @relation("IdeasCreated")
  activityVotes   ActivityVote[]
  travelProfile   TravelProfile?
  tripPreferences TripPreference[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/* ------------------------------------------------------------------ */
/* Travel planner domain models                                        */
/* ------------------------------------------------------------------ */

model Trip {
  id          String    @id @default(cuid())
  title       String
  // Null while the group is still deciding where to go — mirrors the nullable
  // startDate + availability-poll idiom below.
  destination String?
  // Null while the group is still picking dates via the availability poll.
  startDate   DateTime? @db.Date
  endDate     DateTime? @db.Date
  // Availability-poll candidate window and desired trip length; set when the
  // trip is created without fixed dates.
  windowStart  DateTime? @db.Date
  windowEnd    DateTime? @db.Date
  durationDays Int?
  totalBudget Decimal? @db.Decimal(12, 2)
  // Single currency per trip: expense splitting and balances assume it.
  currency    String   @default("USD")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members      TripMember[]
  days         TripDay[]
  invites      Invite[]
  expenses     Expense[]
  settlements  Settlement[]
  availability AvailabilityDay[]
  packingItems PackingItem[]
  packingTemplates PackingTemplate[]
  ideas        ActivityIdea[]
  preferences  TripPreference[]
}

enum TripRole {
  OWNER
  EDITOR
  VIEWER
}

model TripMember {
  id        String   @id @default(cuid())
  role      TripRole @default(VIEWER)
  createdAt DateTime @default(now())
  // Set when this member hid the trip from their own list. Personal: it never
  // changes anyone else's list or what this member can do on the trip.
  archivedAt DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tripId String
  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)

  // A user can only be a member of a trip once
  @@unique([userId, tripId])
  @@index([tripId])
  @@index([userId])
}

model Invite {
  id        String   @id @default(cuid())
  token     String   @unique
  role      TripRole @default(VIEWER)
  expiresAt DateTime
  createdAt DateTime @default(now())
  // Revoked links are kept rather than deleted so opening one can say it was
  // revoked instead of looking like a mistyped URL.
  revokedAt DateTime?

  tripId String
  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)

  createdBy String
  creator   User   @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([tripId])
}

/* ------------------------------------------------------------------ */
/* Expense splitting — all money stored as integer cents               */
/* ------------------------------------------------------------------ */

enum ExpenseCategory {
  FOOD
  TRANSPORT
  LODGING
  ACTIVITY
  SHOPPING
  OTHER
}

model Expense {
  id          String          @id @default(cuid())
  description String
  amountCents Int
  currency    String
  category    ExpenseCategory @default(OTHER)
  date        DateTime        @db.Date
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  tripId String
  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)

  paidById String
  paidBy   User   @relation("ExpensesPaid", fields: [paidById], references: [id], onDelete: Cascade)

  splits ExpenseSplit[]

  @@index([tripId])
  @@index([paidById])
}

model ExpenseSplit {
  id          String @id @default(cuid())
  amountCents Int

  expenseId String
  expense   Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // One share per participant per expense
  @@unique([expenseId, userId])
  @@index([userId])
}

model Settlement {
  id          String   @id @default(cuid())
  amountCents Int
  date        DateTime @default(now())
  createdAt   DateTime @default(now())

  tripId String
  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)

  fromUserId String
  fromUser   User   @relation("SettlementsFrom", fields: [fromUserId], references: [id], onDelete: Cascade)

  toUserId String
  toUser   User   @relation("SettlementsTo", fields: [toUserId], references: [id], onDelete: Cascade)

  // Who logged the repayment, shown in the trip's repayment history. SetNull
  // so the record survives if the recorder's account is deleted.
  createdById String?
  createdBy   User?   @relation("SettlementsRecorded", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([tripId])
}

// One row per (member, day) the member is available; absence = unavailable.
model AvailabilityDay {
  id        String   @id @default(cuid())
  date      DateTime @db.Date
  createdAt DateTime @default(now())

  tripId String
  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tripId, userId, date])
  @@index([tripId])
}

model TripDay {
  id        String   @id @default(cuid())
  date      DateTime @db.Date
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tripId String
  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)

  activities Activity[]

  // A trip can only have one entry per calendar day
  @@unique([tripId, date])
  @@index([tripId])
}

model Activity {
  id           String    @id @default(cuid())
  title        String
  description  String?
  time         DateTime?
  locationName String?
  latitude     Float?
  longitude    Float?
  cost         Decimal?  @db.Decimal(12, 2)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tripDayId String
  tripDay   TripDay @relation(fields: [tripDayId], references: [id], onDelete: Cascade)

  @@index([tripDayId])
}

/* ------------------------------------------------------------------ */
/* Activity ideas — a voting pool that feeds the itinerary             */
/* ------------------------------------------------------------------ */

model ActivityIdea {
  id            String    @id @default(cuid())
  title         String
  description   String?
  locationName  String?
  // External reference (booking page, review site, …).
  link          String?
  estimatedCost Decimal?  @db.Decimal(12, 2)
  // Set when the idea has been added to the itinerary.
  promotedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tripId String
  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)

  // Proposer; SetNull so ideas survive when the member leaves.
  createdById String?
  createdBy   User?   @relation("IdeasCreated", fields: [createdById], references: [id], onDelete: SetNull)

  votes ActivityVote[]

  @@index([tripId])
}

// Row present = user is interested. One vote per member per idea.
model ActivityVote {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  ideaId String
  idea   ActivityIdea @relation(fields: [ideaId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([ideaId, userId])
  @@index([userId])
}

/* ------------------------------------------------------------------ */
/* Packing list — one shared checklist per trip                        */
/* ------------------------------------------------------------------ */

enum PackingCategory {
  GEAR
  CLOTHING
  TOILETRIES
  ELECTRONICS
  DOCUMENTS
  FOOD
  OTHER
}

model PackingItem {
  id        String          @id @default(cuid())
  name      String
  category  PackingCategory @default(OTHER)
  packed    Boolean         @default(false)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  tripId String
  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)

  // Optional member bringing the item; SetNull so a shared item survives if
  // the assigned member is later removed from the trip.
  assigneeId String?
  assignee   User?   @relation("PackingAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  // Null = shared trip item; set = private item on that member's personal
  // list. Cascade so personal items don't outlive (and leak from) their owner.
  ownerId String?
  owner   User?   @relation("PersonalPackingItems", fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([tripId, ownerId])
  @@index([assigneeId])
}

// A reusable packing list any member can import into their personal
// checklist. Built-in templates live in code (lib/packing-templates.ts);
// these rows are the custom ones OWNER/EDITOR members create per trip.
model PackingTemplate {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tripId String
  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)

  items PackingTemplateItem[]

  @@index([tripId])
}

model PackingTemplateItem {
  id       String          @id @default(cuid())
  name     String
  category PackingCategory @default(OTHER)

  templateId String
  template   PackingTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
}

/* ------------------------------------------------------------------ */
/* Travel preferences — durable per-user taste + per-trip answers      */
/* ------------------------------------------------------------------ */

enum TravelPace {
  RELAXED
  BALANCED
  PACKED
}

enum BudgetTier {
  SHOESTRING
  MODERATE
  COMFORT
  LUXURY
}

enum DayRhythm {
  EARLY_BIRD
  FLEXIBLE
  NIGHT_OWL
}

enum LodgingStyle {
  HOSTEL
  RENTAL
  HOTEL
  BOUTIQUE
  CAMPING
}

enum InterestTag {
  FOOD
  NIGHTLIFE
  ART_MUSEUMS
  HISTORY
  NATURE
  HIKING
  BEACH
  WATER_SPORTS
  ADVENTURE
  SHOPPING
  WELLNESS
  LOCAL_LIFE
}

/// Region a member is willing to travel to. ANYWHERE is an explicit "don't
/// care" that is compatible with every other answer (the identity element of
/// the group intersection); null means the member never answered and is left
/// out of consensus entirely. The two are not interchangeable.
enum TravelRegion {
  ANYWHERE
  DOMESTIC
  EUROPE
  ASIA
  AFRICA
  NORTH_AMERICA
  SOUTH_AMERICA
  OCEANIA
}

/// NO_PREFERENCE is an explicit "don't care" (compatible with everything);
/// null means unanswered. See the TravelRegion note.
enum Climate {
  WARM
  MILD
  COLD
  NO_PREFERENCE
}

/// One per user: durable travel taste that outlives any single trip, so a
/// member answers once and every later trip reuses it. Every answer is
/// nullable because every deck question is skippable — null means "never
/// answered" and is excluded from group consensus rather than counted.
model TravelProfile {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pace         TravelPace?
  budgetTier   BudgetTier?
  dayRhythm    DayRhythm?
  lodgingStyle LodgingStyle?

  /// Hard filters, not tastes: free text so a safety-relevant constraint
  /// ("severe tree-nut allergy") survives verbatim into the UI and into future
  /// LLM prompts. Never averaged — unioned across the group. Visible to every
  /// member of every trip this user belongs to; the deck says so at entry.
  dietaryNotes       String?
  accessibilityNotes String?

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  interests TravelInterest[]
}

/// A signed weight per interest tag, -2 (avoid) … +2 (love). A child table
/// rather than columns so the set is SQL-aggregatable for group consensus, and
/// so a future image-swipe deck can just increment weights. The range is
/// enforced in lib/preferences.ts (Prisma can't express a CHECK constraint).
model TravelInterest {
  id     String      @id @default(cuid())
  tag    InterestTag
  weight Int         @default(0)

  profileId String
  profile   TravelProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  // Leading column is profileId, so this doubles as the lookup index.
  @@unique([profileId, tag])
}

/// One per (user, trip): answers that only apply to this trip. Mirrors the
/// AvailabilityDay / ActivityVote per-member-row precedent.
///
/// Fields that also exist on TravelProfile are *overrides*, not deltas: null
/// means "same as my usual", a value means "for this trip specifically".
/// Resolve the pair with resolveEffectiveProfile in lib/preferences.ts rather
/// than reading either side alone.
model TripPreference {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Overrides TravelProfile.budgetTier for this trip; null = same as usual.
  budgetComfort BudgetTier?
  mustDo        String?
  dealBreakers  String?

  /// Only asked while trip.destination is null.
  preferredRegion  TravelRegion?
  preferredClimate Climate?
  /// Hours of travel from home the member will tolerate. The group is limited
  /// by the smallest value, so an Int (min() is free) beats an ordinal enum.
  maxTravelHours Int?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tripId String
  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)

  interests TripInterest[]

  @@unique([userId, tripId])
  // tripId isn't the leading column of the unique above, and the Preferences
  // tab queries by it.
  @@index([tripId])
}

/// A member's interest weights for one trip specifically, in the same -2…+2
/// scale as TravelInterest. These are absolute values, not deltas: when a
/// TripPreference has any of these rows they replace the durable set wholesale
/// for that trip, and when it has none the durable set applies unchanged.
///
/// Storing overrides rather than deltas is what keeps a trip answer from
/// permanently rewriting the member's general taste, and what makes an answer
/// readable back out again (a delta folded into a shared weight isn't).
model TripInterest {
  id     String      @id @default(cuid())
  tag    InterestTag
  weight Int         @default(0)

  tripPreferenceId String
  tripPreference   TripPreference @relation(fields: [tripPreferenceId], references: [id], onDelete: Cascade)

  @@unique([tripPreferenceId, tag])
}
